---
// Waitlist signup. Set app.waitlist.app (the app's slug in the waitlist API) to turn it on.
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { app } from '../app.config';
const enabled = Boolean(app.waitlist.app);
---
<Base title="Join the waitlist" description={`Join the ${app.name} waitlist and get one email when it launches.`}>
  <article class="wrap waitlist-page">
    <p class="eyebrow">Launching soon</p>
    <h1>Join the waitlist</h1>
    {enabled ? (
      <>
        <p class="lead">{app.cta.note}</p>
        <div class="card">
          <WaitlistForm app={app.waitlist.app} />
        </div>
      </>
    ) : (
      <p class="lead">The waitlist opens soon.</p>
    )}
  </article>
</Base>

<style>
  .waitlist-page { max-width: 560px; padding-top: 48px; }
  .eyebrow { font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin: 0 0 8px; }
  h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 8vw, 3.2rem); line-height: 1; letter-spacing: -.02em; margin: 0 0 14px; }
  .lead { color: var(--muted); font-size: 1.08rem; margin: 0 0 28px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
</style>
