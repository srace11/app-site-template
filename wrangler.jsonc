{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name in Cloudflare, usually "<appname>-site". Must match the dashboard.
  "name": "sample-app-site",
  "compatibility_date": "2026-09-01",
  // Builds the Astro site before every deploy, then serves dist/ as static files.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Attaches the subdomain and creates its DNS record on deploy. Set it to the app's address.
  "routes": [{ "pattern": "sample.shaneracey.com", "custom_domain": true }]
}
